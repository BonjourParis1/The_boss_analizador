# ============================================================
#  Guía Experto de Trading — PLANTILLA de variables de entorno
#
#  ¿Qué es este archivo?
#  Es solo un EJEMPLO que documenta qué variables necesita el sistema.
#  NO contiene secretos y SÍ se sube a git (es seguro).
#
#  ¿Qué tengo que hacer?
#  1) Copia este archivo y renómbralo a  .env
#         Windows:  copy .env.example .env
#  2) Rellena tus valores reales en  .env
#  3) El archivo  .env  está en .gitignore -> NUNCA se sube al repo.
# ============================================================

# ---------------- Supabase (base de datos) ----------------
# URL del proyecto (Project Settings -> API -> Project URL)
SUPABASE_URL=https://iytcdpgsuxaptsnabdfl.supabase.co
# service_role key (Project Settings -> API). ¡SECRETO! Da acceso total.
# >>> Pega aquí la clave que generes DESPUÉS de rotarla en Supabase <<<
SUPABASE_SERVICE_KEY=

# ---------------- Datos de mercado ----------------
# Alpha Vantage: necesaria para FOREX/acciones INTRADÍA reales.
# Consíguela gratis en https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ---------------- Cerebro IA (GRATIS, sin API de pago) ----------------
# Proveedor: ollama (local) | gemini (nube free) | openai_compatible | none
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
# Gemini free tier (https://aistudio.google.com/apikey). ¡SECRETO!
# La clave puede empezar por "AIza..." o por "AQ." (ambas válidas según Google AI Studio).
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
# Servidor compatible OpenAI: LM Studio (local) o Groq/Together/DeepInfra (nube free)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=

# ---------------- Datos en tiempo real adicionales (opcional) ----------------
# Finnhub (https://finnhub.io, free 60/min): precio en vivo de acciones de EE. UU.
FINNHUB_API_KEY=
# Twelve Data (https://twelvedata.com, free 800/día, 8/min): FOREX intradía en vivo
TWELVEDATA_API_KEY=
# YouTube Data API (opcional): para que el Cerebro IA investigue videos de trading
YOUTUBE_API_KEY=

# ---------------- Noticias (opcional) ----------------
# NewsAPI (https://newsapi.org) mejora la cobertura. Si se deja vacío,
# el sistema usa feeds RSS públicos (sin clave).
NEWSAPI_KEY=

# ---------------- Escáner autónomo ----------------
SCAN_INTERVAL_MINUTES=15

# ---------------- Avisos por correo (DESACTIVADO por defecto) ----------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jhonslylouis@gmail.com
# 'App password' de Gmail (NO tu contraseña normal). ¡SECRETO!
SMTP_PASSWORD=
EMAIL_TO=jhonslylouis@gmail.com

# ---------------- Seguridad del login ----------------
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300

# ---------------- Tiempo real ----------------
REFRESH_SECONDS=5
