# ============================================================
#  Guía Experto de Trading — variables de entorno
#  Copia este archivo como  .env  y rellena tus valores.
#  El archivo .env está en .gitignore: NUNCA se sube al repo.
# ============================================================

# --- API keys (opcionales; sin ellas se usan fuentes sin clave) ---
ALPHA_VANTAGE_API_KEY=

# --- Base de datos ---
# SQLite (prototipo, por defecto):
DATABASE_URL=sqlite:///db/trading.db
# PostgreSQL (producción), ejemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/trading

# --- Seguridad del login (NO pongas claves aquí) ---
# Las 3 claves de administrador se almacenan HASHEADAS en .secrets/admin_keys.json
# generado por  setup_admin.py.  Aquí solo configuras parámetros:
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300

# --- Datos / refresco ---
REFRESH_SECONDS=5
